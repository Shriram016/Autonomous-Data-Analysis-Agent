# ADAA V3 settings. Copy to .env (git-ignored) and fill in. Never commit real values.
# Every setting the app reads is listed here; the app refuses to start if a required one is missing.

# Environment: local | prod
ADAA_APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
ADAA_LOG_LEVEL=INFO

# Postgres (docker-compose reads these too)
ADAA_DB_HOST=127.0.0.1
ADAA_DB_PORT=5433
ADAA_DB_NAME=adaa
ADAA_DB_USER=adaa_owner
# Required (owner role: setup only). Any long random string for local use.
ADAA_DB_PASSWORD=
# Required for loading and daily ingestion (role adaa_loader).
ADAA_DB_LOADER_PASSWORD=
# Required for the agent's read-only queries (role adaa_query).
ADAA_DB_QUERY_PASSWORD=

# Redis
ADAA_REDIS_URL=redis://127.0.0.1:6379/0

# LLM provider (M1.2). Get a key at platform.claude.com.
ANTHROPIC_API_KEY=
# Router (M2 step 2): Jev through OpenRouter. Get a key at openrouter.ai.
OPENROUTER_API_KEY=

# App role (M1.5): reads/writes the conversation schema only
ADAA_DB_APP_PASSWORD=
# Review ingestion (M3): reads business, writes business.review_vectors only
ADAA_DB_REVIEW_WRITER_PASSWORD=
