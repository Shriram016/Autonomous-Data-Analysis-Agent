{
  "openapi": "3.1.0",
  "info": {
    "title": "ADAA API",
    "version": "0.1.0"
  },
  "paths": {
    "/questions": {
      "post": {
        "summary": "Ask Question",
        "description": "202 Accepted: the question is queued, not answered yet.",
        "operationId": "ask_question_questions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/questions/{question_id}": {
      "get": {
        "summary": "Read Question",
        "operationId": "read_question_questions__question_id__get",
        "parameters": [
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Question Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/questions/{question_id}/events": {
      "get": {
        "summary": "Stream Question",
        "operationId": "stream_question_questions__question_id__events_get",
        "parameters": [
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Question Id"
            }
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Chart": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "line",
              "bar"
            ],
            "title": "Kind"
          },
          "x_label": {
            "type": "string",
            "title": "X Label"
          },
          "y_label": {
            "type": "string",
            "title": "Y Label"
          },
          "unit": {
            "type": "string",
            "enum": [
              "count",
              "BRL",
              "ratio",
              "days",
              "score"
            ],
            "title": "Unit"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ChartPoint"
            },
            "type": "array",
            "title": "Points"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "x_label",
          "y_label",
          "unit",
          "points"
        ],
        "title": "Chart"
      },
      "ChartPoint": {
        "properties": {
          "x": {
            "type": "string",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "ChartPoint"
      },
      "FinishedAnswer": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "failed"
            ],
            "title": "Status"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "error_kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "llm_unavailable",
                  "llm_output",
                  "value_not_found",
                  "compile_refused",
                  "query_timeout",
                  "data_unavailable",
                  "job_timeout"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Kind"
          },
          "table": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Table"
              },
              {
                "type": "null"
              }
            ]
          },
          "chart": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Chart"
              },
              {
                "type": "null"
              }
            ]
          },
          "how": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "How",
            "default": []
          },
          "used_template": {
            "type": "boolean",
            "title": "Used Template",
            "default": false
          },
          "versions": {
            "$ref": "#/components/schemas/Versions"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "type": "object",
        "required": [
          "question",
          "status",
          "text",
          "versions",
          "usage"
        ],
        "title": "FinishedAnswer"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuestionCreated": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "QuestionCreated"
      },
      "QuestionIn": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QuestionIn"
      },
      "QuestionRecord": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "owner": {
            "type": "string",
            "title": "Owner"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "state": {
            "type": "string",
            "enum": [
              "waiting",
              "running",
              "done",
              "failed"
            ],
            "title": "State"
          },
          "answer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FinishedAnswer"
              },
              {
                "type": "null"
              }
            ]
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens"
          },
          "thinking_tokens": {
            "type": "integer",
            "title": "Thinking Tokens"
          },
          "cost_usd": {
            "type": "string",
            "title": "Cost Usd"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "wait_seconds": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wait Seconds"
          },
          "total_seconds": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Seconds"
          }
        },
        "type": "object",
        "required": [
          "id",
          "owner",
          "question",
          "state",
          "answer",
          "input_tokens",
          "output_tokens",
          "thinking_tokens",
          "cost_usd",
          "created_at",
          "started_at",
          "finished_at",
          "wait_seconds",
          "total_seconds"
        ],
        "title": "QuestionRecord"
      },
      "Table": {
        "properties": {
          "headers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Headers"
          },
          "rows": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "type": "object",
        "required": [
          "headers",
          "rows"
        ],
        "title": "Table"
      },
      "Usage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Input Tokens"
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Output Tokens"
          },
          "thinking_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Thinking Tokens",
            "default": 0
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cost Usd"
          }
        },
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens",
          "cost_usd"
        ],
        "title": "Usage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Versions": {
        "properties": {
          "semantic_layer": {
            "type": "string",
            "title": "Semantic Layer"
          },
          "agent_prompt": {
            "type": "string",
            "title": "Agent Prompt"
          },
          "answer_prompt": {
            "type": "string",
            "title": "Answer Prompt"
          }
        },
        "type": "object",
        "required": [
          "semantic_layer",
          "agent_prompt",
          "answer_prompt"
        ],
        "title": "Versions",
        "description": "What produced the answer: 'version (first 12 characters of the fingerprint)'."
      }
    }
  }
}
